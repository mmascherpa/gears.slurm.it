{
  "name": "slurm-spa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/preserve-deploy-files.js backup && vite build && node scripts/update-sw-cache.js && node scripts/preserve-deploy-files.js restore",
    "build:skip-push": "npm run build",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "exifr": "^7.1.3",
    "file-type": "^19.0.0",
    "lucide-vue-next": "^0.553.0",
    "piexifjs": "^1.0.6",
    "png-metadata": "^1.0.2",
    "qrcode": "^1.5.4",
    "stream": "^0.0.2",
    "util": "^0.12.5",
    "vue": "^3.3.11",
    "vue-meta": "^2.4.0",
    "vue-router": "^4.2.5",
    "vuetify": "^3.4.8"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/ui": "^4.0.6",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.10",
    "sharp": "^0.33.2",
    "vite": "^5.0.10",
    "vite-plugin-webfont-dl": "^3.11.1",
    "vitest": "^4.0.6"
  }
